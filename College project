DECLARE 
    V_EMPLOYEE EMPLOYEE.EMP_NAME%TYPE;
BEGIN 
    SELECT EMP_NAME INTO V_EMPLOYEE 
    FROM EMPLOYEE 
    WHERE EMP_ID = 101; 
    
    DBMS_OUTPUT.PUT_LINE('EMPLOYEE NAME : ' || V_EMPLOYEE); 
END;
/

DECLARE 
    V_SALARY EMPLOYEE.SALARY%TYPE;
BEGIN 
    SELECT SALARY INTO V_SALARY
    FROM EMPLOYEE 
    WHERE EMP_ID = 101; 

    IF V_SALARY >= 50000 THEN
       DBMS_OUTPUT.PUT_LINE('HIGH EARNER');
    ELSE
       DBMS_OUTPUT.PUT_LINE('NORMAL EARNER');
    END IF;
END;
/

DECLARE 
    CURSOR NEW IS SELECT EMP_NAME FROM EMPLOYEE; 
    V_EMPLOYEE EMPLOYEE.EMP_NAME%TYPE; 
BEGIN 
    OPEN NEW;
    LOOP
        FETCH NEW INTO V_EMPLOYEE;
        EXIT WHEN NEW%NOTFOUND;
        DBMS_OUTPUT.PUT_LINE('EMPLOYEE NAME: ' || V_EMPLOYEE);
    END LOOP;
    CLOSE NEW;
END;
/

DECLARE
    v_name EMPLOYEE.EMP_NAME%TYPE;
BEGIN
    SELECT EMP_NAME INTO v_name
    FROM EMPLOYEE
    WHERE EMP_ID = 101;
    
    DBMS_OUTPUT.PUT_LINE('Employee Name: ' || v_name);
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        DBMS_OUTPUT.PUT_LINE('No Employee found with given ID');
END;
/

CREATE OR REPLACE PROCEDURE Increase_Salary(p_EmpID INT, p_Amount DECIMAL) AS
BEGIN 
    UPDATE EMPLOYEE
    SET SALARY = SALARY + p_Amount
    WHERE EMP_ID = p_EmpID;
    
    DBMS_OUTPUT.PUT_LINE('Salary updated for Employee ID: ' || p_EmpID);
END Increase_Salary;
/

BEGIN
    Increase_Salary(101, 2000);
END;
/

CREATE OR REPLACE FUNCTION Get_DeptName(p_EmpID INT) RETURN VARCHAR IS
    v_DeptName DEPARTMENT.DEPT_NAME%TYPE;
BEGIN
    SELECT D.DEPT_NAME INTO v_DeptName
    FROM EMPLOYEE E 
    JOIN DEPARTMENT D ON E.DEPT_ID = D.DEPT_ID
    WHERE E.EMP_ID = p_EmpID;
    
    RETURN v_DeptName;
END Get_DeptName;
/

DECLARE
    v_dept VARCHAR(100);
BEGIN
    v_dept := Get_DeptName(101);
    DBMS_OUTPUT.PUT_LINE('Department: ' || v_dept);
END;
/


