/* =====================================================
   BASIC QUERIES
   ===================================================== */

-- 1. Display all customers

SELECT * FROM customers;


-- 2. Display all accounts

SELECT * FROM accounts;


-- 3. Display customers from Kolkata

SELECT *
FROM customers
WHERE city = 'Kolkata';


-- 4. Display Savings accounts

SELECT *
FROM accounts
WHERE account_type = 'Savings';


-- 5. Accounts having balance above 50000

SELECT *
FROM accounts
WHERE balance > 50000;


/* =====================================================
   JOIN QUERIES
   ===================================================== */

-- 6. Customer and Account Details

SELECT
    c.customer_id,
    c.name,
    c.phone,
    a.account_number,
    a.account_type,
    a.balance
FROM customers c
INNER JOIN accounts a
ON c.customer_id = a.customer_id;


-- 7. Account and Branch Details

SELECT
    a.account_number,
    a.account_type,
    a.balance,
    b.branch_name,
    b.city
FROM accounts a
INNER JOIN branches b
ON a.branch_id = b.branch_id;


-- 8. Employee and Branch Details

SELECT
    e.employee_name,
    e.designation,
    e.salary,
    b.branch_name,
    b.city
FROM employees e
INNER JOIN branches b
ON e.branch_id = b.branch_id;


/* =====================================================
   AGGREGATE FUNCTIONS
   ===================================================== */

-- 9. Total Bank Balance

SELECT
    SUM(balance) AS total_bank_balance
FROM accounts;


-- 10. Average Balance

SELECT
    AVG(balance) AS average_balance
FROM accounts;


-- 11. Highest Balance

SELECT
    MAX(balance) AS highest_balance
FROM accounts;


-- 12. Lowest Balance

SELECT
    MIN(balance) AS lowest_balance
FROM accounts;


-- 13. Total Number of Customers

SELECT
    COUNT(*) AS total_customers
FROM customers;


/* =====================================================
   GROUP BY
   ===================================================== */

-- 14. Number of Accounts by Type

SELECT
    account_type,
    COUNT(*) AS total_accounts
FROM accounts
GROUP BY account_type;


-- 15. Total Balance by Account Type

SELECT
    account_type,
    SUM(balance) AS total_balance
FROM accounts
GROUP BY account_type;


-- 16. Customers by City

SELECT
    city,
    COUNT(*) AS total_customers
FROM customers
GROUP BY city;


/* =====================================================
   HAVING
   ===================================================== */

-- 17. Account Types having total balance above 100000

SELECT
    account_type,
    SUM(balance) AS total_balance
FROM accounts
GROUP BY account_type
HAVING SUM(balance) > 100000;


/* =====================================================
   SUBQUERIES
   ===================================================== */

-- 18. Accounts having balance above average

SELECT *
FROM accounts
WHERE balance >
(
    SELECT AVG(balance)
    FROM accounts
);


-- 19. Customer having highest balance

SELECT
    c.name,
    a.account_number,
    a.balance
FROM customers c
INNER JOIN accounts a
ON c.customer_id = a.customer_id
WHERE a.balance =
(
    SELECT MAX(balance)
    FROM accounts
);


/* =====================================================
   LOAN QUERIES
   ===================================================== */

-- 20. Display approved loans

SELECT *
FROM loans
WHERE status = 'Approved';


-- 21. Total approved loan amount

SELECT
    SUM(loan_amount) AS total_approved_loan
FROM loans
WHERE status = 'Approved';


-- 22. Customer Loan Details

SELECT
    c.name,
    l.loan_type,
    l.loan_amount,
    l.interest_rate,
    l.status
FROM customers c
INNER JOIN loans l
ON c.customer_id = l.customer_id;


/* =====================================================
   VIEW 1
   ===================================================== */

CREATE VIEW customer_account_details AS
SELECT
    c.customer_id,
    c.name,
    c.email,
    c.phone,
    a.account_number,
    a.account_type,
    a.balance,
    a.status
FROM customers c
INNER JOIN accounts a
ON c.customer_id = a.customer_id;


-- Display View

SELECT *
FROM customer_account_details;


/* =====================================================
   VIEW 2
   ===================================================== */

CREATE VIEW transaction_history AS
SELECT
    t.transaction_id,
    a.account_number,
    c.name,
    t.transaction_type,
    t.amount,
    t.transaction_date,
    t.description
FROM transactions t
INNER JOIN accounts a
ON t.account_id = a.account_id
INNER JOIN customers c
ON a.customer_id = c.customer_id;


-- Display transaction history

SELECT *
FROM transaction_history;


/* =====================================================
   INDEXES
   ===================================================== */

CREATE INDEX idx_customer_name
ON customers(name);

CREATE INDEX idx_account_number
ON accounts(account_number);

CREATE INDEX idx_transaction_date
ON transactions(transaction_date);


/* =====================================================
   FINAL BANKING REPORT
   ===================================================== */

SELECT
    c.name AS customer_name,
    a.account_number,
    a.account_type,
    a.balance,
    b.branch_name,
    b.city
FROM customers c
INNER JOIN accounts a
ON c.customer_id = a.customer_id
INNER JOIN branches b
ON a.branch_id = b.branch_id
ORDER BY a.balance DESC;
