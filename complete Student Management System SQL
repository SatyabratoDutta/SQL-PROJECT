SELECT
    s.roll_no,
    s.name,
    f.total_fee,
    f.paid_amount,
    (f.total_fee - f.paid_amount) AS due_amount
FROM Fees f
JOIN Students s
ON f.student_id = s.student_id
WHERE f.total_fee > f.paid_amount;


SELECT
    s.roll_no,
    s.name,
    f.total_fee,
    f.paid_amount
FROM Fees f
JOIN Students s
ON f.student_id = s.student_id
WHERE f.total_fee = f.paid_amount;


