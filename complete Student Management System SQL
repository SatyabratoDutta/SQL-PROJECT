CREATE TABLE Students (
    student_id INT PRIMARY KEY AUTO_INCREMENT,
    roll_no VARCHAR(20) NOT NULL UNIQUE,
    name VARCHAR(100) NOT NULL,
    email VARCHAR(100) UNIQUE,
    phone VARCHAR(15),
    gender VARCHAR(10),
    dob DATE,
    address VARCHAR(255),
    department_id INT,
    semester INT,
    admission_year INT,

    FOREIGN KEY (department_id)
