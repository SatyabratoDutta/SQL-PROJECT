SELECT * FROM Students;


SELECT
    s.roll_no,
    s.name,
    d.department_name,
    s.semester
FROM Students s
JOIN Departments d
ON s.department_id = d.department_id;


SELECT
    s.roll_no,
    s.name,
    c.course_code,
    c.course_name,
    e.grade
FROM Students s
JOIN Enrollment e
ON s.student_id = e.student_id
JOIN Courses c
ON e.course_id = c.course_id
ORDER BY s.roll_no;


SELECT
    s.roll_no,
    s.name,
    c.course_name,
    ex.exam_name,
    m.marks
FROM Marks m
JOIN Students s
ON m.student_id = s.student_id
JOIN Courses c
ON m.course_id = c.course_id
JOIN Exams ex
ON m.exam_id = ex.exam_id
ORDER BY s.roll_no;


SELECT
    s.roll_no,
    s.name,
    c.course_name,
    a.total_classes,
    a.attended_classes,
    ROUND(
        a.attended_classes * 100.0 /
        NULLIF(a.total_classes, 0),
        2
    ) AS attendance_percentage
FROM Attendance a
JOIN Students s
ON a.student_id = s.student_id
JOIN Courses c
ON a.course_id = c.course_id;


SELECT
    s.roll_no,
    s.name,
    c.course_name,
    ROUND(
        a.attended_classes * 100.0 /
        NULLIF(a.total_classes, 0),
        2
    ) AS attendance_percentage
FROM Attendance a
JOIN Students s
ON a.student_id = s.student_id
JOIN Courses c
ON a.course_id = c.course_id
WHERE
    a.attended_classes * 100.0 /
    NULLIF(a.total_classes, 0) < 75;


SELECT
    s.name,
    c.course_name,
    m.marks
FROM Marks m
JOIN Students s
ON m.student_id = s.student_id
JOIN Courses c
ON m.course_id = c.course_id
WHERE m.marks = (
    SELECT MAX(marks)
    FROM Marks
);


SELECT
    s.name,
    ROUND(AVG(m.marks), 2) AS average_marks
FROM Marks m
JOIN Students s
ON m.student_id = s.student_id
GROUP BY s.student_id, s.name;


SELECT COUNT(*) AS total_students
FROM Students;


SELECT
    d.department_name,
    COUNT(s.student_id) AS total_students
FROM Departments d
LEFT JOIN Students s
ON d.department_id = s.department_id
GROUP BY d.department_id, d.department_name;


SELECT
    s.name,
    c.course_name,
    e.grade
FROM Enrollment e
JOIN Students s
ON e.student_id = s.student_id
JOIN Courses c
ON e.course_id = c.course_id
WHERE e.grade = 'A+';


