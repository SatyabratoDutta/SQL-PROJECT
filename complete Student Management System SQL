CREATE VIEW Student_Report AS
SELECT
    s.roll_no,
    s.name,
    d.department_name,
    c.course_name,
    e.grade
FROM Students s
JOIN Departments d
ON s.department_id = d.department_id
JOIN Enrollment e
ON s.student_id = e.student_id
JOIN Courses c
ON e.course_id = c.course_id;


SELECT * FROM Student_Report;


CREATE VIEW Attendance_Report AS
SELECT
    s.roll_no,
    s.name,
    c.course_name,
    a.total_classes,
    a.attended_classes,
    ROUND(
        a.attended_classes * 100.0 /
        NULLIF(a.total_classes, 0),
        2
    ) AS attendance_percentage
FROM Attendance a
JOIN Students s
ON a.student_id = s.student_id
JOIN Courses c
ON a.course_id = c.course_id;


SELECT * FROM Attendance_Report;


SELECT
    s.roll_no,
    s.name,
    ROUND(AVG(m.marks), 2) AS average_marks
FROM Marks m
JOIN Students s
ON m.student_id = s.student_id
GROUP BY s.student_id, s.roll_no, s.name
ORDER BY average_marks DESC
LIMIT 5;


SELECT
    c.course_code,
    c.course_name,
    ROUND(AVG(m.marks), 2) AS average_marks
FROM Marks m
JOIN Courses c
ON m.course_id = c.course_id
GROUP BY c.course_id, c.course_code, c.course_name
ORDER BY average_marks DESC;


